<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="8TFVnyJ39nwos5hWgCxJcaCTfAzvcIz4QvkVBcY_FEo" />

  <!-- Primary SEO Meta Tags -->
  <title>Autotrad AI - Autonomous AI Crypto Trading Platform</title>
  <meta name="title" content="Autotrad AI - Autonomous AI Crypto Trading Platform" />
  <meta name="description" content="Autotrad AI is an autonomous, AI-powered cryptocurrency trading system designed for real-time market tracking and automated execution." />
  <meta name="keywords" content="autotrad-ai, autotrad, ai crypto trading, crypto bot, algorithmic trading, trading automation" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://abrarpersnol-web.github.io/autotrad-ai/" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://abrarpersnol-web.github.io/autotrad-ai/" />
  <meta property="og:title" content="Autotrad AI - Autonomous AI Crypto Trading Platform" />
  <meta property="og:description" content="Autotrad AI is an autonomous, AI-powered cryptocurrency trading system designed for automated strategies." />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="https://abrarpersnol-web.github.io/autotrad-ai/" />
  <meta property="twitter:title" content="Autotrad AI - Autonomous AI Crypto Trading Platform" />
  <meta property="twitter:description" content="Autotrad AI is an autonomous, AI-powered cryptocurrency trading system designed for automated strategies." />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between">

  <!-- Header / Navbar -->
  <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center font-bold text-xl text-white">A</div>
        <span class="text-xl font-bold tracking-tight text-white">Autotrad <span class="text-blue-500">AI</span></span>
      </div>
      <a href="#features" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition">
        Get Started
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="max-w-5xl mx-auto px-6 py-20 text-center">
    <span class="inline-block px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold tracking-wide uppercase mb-6">
      AI-Powered Trading Automation
    </span>
    
    <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight mb-6 leading-tight">
      Automate Your Crypto Strategies with <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Autotrad AI</span>
    </h1>
    
    <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10">
      Experience real-time market execution, continuous trend monitoring, and automated algorithmic strategies built for modern crypto markets.
    </p>

    <!-- Call to Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
      <a href="https://github.com/abrarpersnol-web/autotrad-ai" target="_blank" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-base transition shadow-lg shadow-blue-600/25">
        View Repository on GitHub
      </a>
      <a href="#features" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-base border border-slate-700 transition">
        Learn More
      </a>
    </div>

    <!-- Features Grid -->
    <section id="features" class="grid md:grid-cols-3 gap-6 text-left mt-12">
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 font-bold mb-4">01</div>
        <h3 class="text-xl font-bold text-white mb-2">Automated Signals</h3>
        <p class="text-slate-400 text-sm">Real-time signal analysis and automated entry/exit execution based on technical parameters.</p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold mb-4">02</div>
        <h3 class="text-xl font-bold text-white mb-2">24/7 Market Tracking</h3>
        <p class="text-slate-400 text-sm">Continuous monitoring across decentralized protocols and centralized exchange APIs.</p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold mb-4">03</div>
        <h3 class="text-xl font-bold text-white mb-2">Telegram Integration</h3>
        <p class="text-slate-400 text-sm">Receive instant notifications, market updates, and portfolio metrics straight to your phone.</p>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800 bg-slate-900/30 py-8">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-slate-500 text-sm">
      <p>&copy; 2026 Autotrad AI. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="https://github.com/abrarpersnol-web" target="_blank" class="hover:text-slate-300 transition">GitHub Profile</a>
        <a href="https://abrarpersnol-web.github.io/autotrad-ai/" class="hover:text-slate-300 transition">Website Root</a>
      </div>
    </div>
  </footer>

</body>
</html>
