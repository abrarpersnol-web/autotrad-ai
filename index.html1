<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Search Console Verification Tag -->
  <meta name="google-site-verification" content="8TFVnyJ39nwos5hWgCxJcaCTfAzvcIz4QvkVBcY_FEo" />

  <!-- Primary SEO Meta Tags -->
  <title>Autotrad AI - Autonomous AI Crypto Trading Platform</title>
  <meta name="title" content="Autotrad AI - Autonomous AI Crypto Trading Platform" />
  <meta name="description" content="Autotrad AI is an autonomous, AI-powered cryptocurrency trading system with USDT deposit integration and real-time market execution." />
  <meta name="keywords" content="autotrad-ai, autotrad, ai crypto trading, crypto bot, usdt deposit, algorithmic trading" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://abrarpersnol-web.github.io/autotrad-ai/" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://abrarpersnol-web.github.io/autotrad-ai/" />
  <meta property="og:title" content="Autotrad AI - Autonomous AI Crypto Trading Platform" />
  <meta property="og:description" content="Autotrad AI is an autonomous, AI-powered cryptocurrency trading system designed for automated strategies." />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between">

  <!-- Header / Navbar -->
  <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center font-bold text-xl text-white">A</div>
        <span class="text-xl font-bold tracking-tight text-white">Autotrad <span class="text-blue-500">AI</span></span>
      </div>
      <a href="#deposit" class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-sm transition flex items-center gap-2">
        <span>Deposit USDT</span>
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="max-w-5xl mx-auto px-6 py-16 text-center">
    <span class="inline-block px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold tracking-wide uppercase mb-6">
      AI-Powered Trading Automation
    </span>
    
    <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight mb-6 leading-tight">
      Automate Your Crypto Strategies with <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Autotrad AI</span>
    </h1>
    
    <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10">
      Experience real-time market execution, continuous trend monitoring, and automated algorithmic trading powered by USDT funds.
    </p>

    <!-- Call to Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
      <a href="#deposit" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-base transition shadow-lg shadow-emerald-600/25">
        Deposit USDT
      </a>
      <a href="#features" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-base border border-slate-700 transition">
        Learn More
      </a>
    </div>

    <!-- Features Grid -->
    <section id="features" class="grid md:grid-cols-3 gap-6 text-left mb-20">
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 font-bold mb-4">01</div>
        <h3 class="text-xl font-bold text-white mb-2">Automated Signals</h3>
        <p class="text-slate-400 text-sm">Real-time signal analysis and automated entry/exit execution based on technical parameters.</p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold mb-4">02</div>
        <h3 class="text-xl font-bold text-white mb-2">USDT Wallet Integration</h3>
        <p class="text-slate-400 text-sm">Seamless deposit options via TRC20 and ERC20 networks for instant trading allocation.</p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold mb-4">03</div>
        <h3 class="text-xl font-bold text-white mb-2">Telegram Bot Execution</h3>
        <p class="text-slate-400 text-sm">Receive instant trade notifications, execution alerts, and portfolio tracking on Telegram.</p>
      </div>
    </section>

    <!-- USDT Deposit Section -->
    <section id="deposit" class="max-w-2xl mx-auto text-left bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-bold text-lg">₮</div>
        <div>
          <h2 class="text-2xl font-bold text-white">Deposit USDT</h2>
          <p class="text-xs text-slate-400">Fund your account to activate automated bot trading</p>
        </div>
      </div>

      <!-- Network Selection Tabs -->
      <div class="mb-6">
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Select Network</label>
        <div class="grid grid-cols-2 gap-3">
          <button id="btn-trc20" onclick="switchNetwork('trc20')" class="py-2.5 px-4 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-400 font-semibold text-sm transition text-center">
            TRC20 (Tron)
          </button>
          <button id="btn-erc20" onclick="switchNetwork('erc20')" class="py-2.5 px-4 rounded-xl border border-slate-800 bg-slate-950 text-slate-400 font-semibold text-sm transition text-center hover:border-slate-700">
            ERC20 (Ethereum)
          </button>
        </div>
      </div>

      <!-- Deposit Address Box -->
      <div class="mb-6">
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">USDT Deposit Address</label>
        <div class="flex items-center bg-slate-950 border border-slate-800 rounded-xl p-3 gap-2">
          <input id="usdt-address" type="text" readonly value="YOUR_TRC20_WALLET_ADDRESS" class="bg-transparent border-none text-slate-200 text-xs sm:text-sm font-mono w-full focus:outline-none" />
          <button onclick="copyAddress()" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs transition shrink-0">
            Copy
          </button>
        </div>
        <p id="copy-status" class="text-emerald-400 text-xs mt-2 hidden">Address copied to clipboard!</p>
      </div>

      <!-- Deposit Amount Calculator -->
      <div class="border-t border-slate-800 pt-6">
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Enter Deposit Amount (USDT)</label>
        <div class="flex items-center bg-slate-950 border border-slate-800 rounded-xl px-3 py-2">
          <input id="deposit-amount" type="number" placeholder="100" oninput="calculateTradingPower()" class="bg-transparent border-none text-white text-lg font-bold w-full focus:outline-none" />
          <span class="text-emerald-400 font-bold text-sm">USDT</span>
        </div>
        <div class="mt-4 p-4 rounded-xl bg-slate-950/50 border border-slate-800/80 flex justify-between items-center text-xs">
          <span class="text-slate-400">Estimated Bot Daily Volume:</span>
          <span id="estimated-volume" class="font-bold text-white">$0.00 USDT</span>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800 bg-slate-900/30 py-8 mt-12">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-slate-500 text-sm">
      <p>&copy; 2026 Autotrad AI. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="https://github.com/abrarpersnol-web" target="_blank" class="hover:text-slate-300 transition">GitHub Profile</a>
        <a href="https://abrarpersnol-web.github.io/autotrad-ai/" class="hover:text-slate-300 transition">Website Root</a>
      </div>
    </div>
  </footer>

  <!-- JavaScript for USDT Wallet Functions -->
  <script>
    const addresses = {
      trc20: "YOUR_TRC20_WALLET_ADDRESS",
      erc20: "YOUR_ERC20_WALLET_ADDRESS"
    };

    function switchNetwork(network) {
      const addressInput = document.getElementById('usdt-address');
      const btnTrc20 = document.getElementById('btn-trc20');
      const btnErc20 = document.getElementById('btn-erc20');

      addressInput.value = addresses[network];

      if (network === 'trc20') {
        btnTrc20.className = "py-2.5 px-4 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-400 font-semibold text-sm transition text-center";
        btnErc20.className = "py-2.5 px-4 rounded-xl border border-slate-800 bg-slate-950 text-slate-400 font-semibold text-sm transition text-center hover:border-slate-700";
      } else {
        btnErc20.className = "py-2.5 px-4 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-400 font-semibold text-sm transition text-center";
        btnTrc20.className = "py-2.5 px-4 rounded-xl border border-slate-800 bg-slate-950 text-slate-400 font-semibold text-sm transition text-center hover:border-slate-700";
      }
    }

    function copyAddress() {
      const addressInput = document.getElementById('usdt-address');
      navigator.clipboard.writeText(addressInput.value);
      const copyStatus = document.getElementById('copy-status');
      copyStatus.classList.remove('hidden');
      setTimeout(() => {
        copyStatus.classList.add('hidden');
      }, 2500);
    }

    function calculateTradingPower() {
      const amount = parseFloat(document.getElementById('deposit-amount').value) || 0;
      const estimatedVolume = amount * 3.5;
      document.getElementById('estimated-volume').innerText = '$' + estimatedVolume.toFixed(2) + ' USDT';
    }
  </script>

</body>
</html>
